---
import { ui } from "src/i18n";
import { formatUiDate } from "src/i18n/format";
import type { LibraryItem, FrontmatterValue } from "src/lib/vault";
import TagPills from "src/components/notes/TagPills.astro";

interface Props {
	note: LibraryItem;
}

const { note } = Astro.props;

const visibleKeys = ["type", "status", "travel-type", "country", "continent", "created", "updated"];
const labels: Record<string, string> = {
	type: ui.noteDetail.metadataLabels.type,
	status: ui.noteDetail.metadataLabels.status,
	"travel-type": ui.noteDetail.metadataLabels.travelType,
	country: ui.noteDetail.metadataLabels.country,
	continent: ui.noteDetail.metadataLabels.continent,
	created: ui.noteDetail.metadataLabels.created,
	updated: ui.noteDetail.metadataLabels.updated,
};

function formatDate(value: string) {
	const timestamp = Date.parse(value);
	if (Number.isNaN(timestamp)) {
		return value;
	}
	return formatUiDate(new Date(timestamp));
}

function stringifyValue(key: string, value: FrontmatterValue) {
	if (Array.isArray(value)) {
		return value.join(", ");
	}
	if (key === "created" || key === "updated") {
		return formatDate(value);
	}
	return value;
}

const metadata = visibleKeys
	.map((key) => {
		const value = key === "type" ? note.normalized.type : note.normalized.metadata[key];
		if (!value || (Array.isArray(value) && value.length === 0)) {
			return null;
		}
		return { key, label: labels[key], value: stringifyValue(key, value) };
	})
	.filter(Boolean) as Array<{ key: string; label: string; value: string }>;

const aliases = note.normalized.aliases;

const hasContent = metadata.length > 0 || aliases.length > 0 || note.normalized.tags.length > 0;
---

{
	hasContent && (
		<section class="note-properties">
			<div class="space-y-6">
				<h2 class="font-serif text-[1.4rem] font-semibold tracking-[-0.025em] text-[#1d2926]">{ui.noteDetail.properties}</h2>

				{
					metadata.length > 0 && (
						<dl class="note-properties__list">
							{
								metadata.map((entry) => (
									<div class="note-properties__row">
										<dt class="text-[10px] font-semibold uppercase tracking-[0.15em] text-[#7a8782]">
											{entry.label}
										</dt>
										<dd class="mt-1.5 break-words text-sm font-medium leading-6 text-[#35433f]">
											{entry.value}
										</dd>
									</div>
								))
							}
						</dl>
					)
				}

				{
					aliases.length > 0 && (
						<div class="space-y-3 border-t border-[#dfe5e2] pt-5">
							<p class="text-[10px] font-semibold uppercase tracking-[0.15em] text-[#7a8782]">
								{ui.noteDetail.aliases}
							</p>
							<TagPills values={aliases} tone="sky" />
						</div>
					)
				}

				{
					note.normalized.tags.length > 0 && (
						<div class="space-y-3 border-t border-[#dfe5e2] pt-5">
							<p class="text-[10px] font-semibold uppercase tracking-[0.15em] text-[#7a8782]">
								{ui.noteDetail.tags}
							</p>
							<TagPills values={note.normalized.tags.map((tag) => `#${tag}`)} tone="slate" />
						</div>
					)
				}
			</div>
		</section>
	)
}

<style>
	.note-properties {
		padding-block: 0.25rem 1.5rem;
	}

	.note-properties__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		border-block: 1px solid #dfe5e2;
	}

	.note-properties__row {
		min-width: 0;
		padding: 0.9rem 0;
		border-bottom: 1px solid #e6eae8;
	}

	.note-properties__row:nth-child(odd) {
		padding-right: 1rem;
	}

	.note-properties__row:nth-child(even) {
		padding-left: 1rem;
		border-left: 1px solid #e6eae8;
	}

	.note-properties__row:nth-last-child(-n + 2) {
		border-bottom: 0;
	}

	@media (max-width: 390px) {
		.note-properties__list {
			grid-template-columns: minmax(0, 1fr);
		}

		.note-properties__row:nth-child(n) {
			padding-inline: 0;
			border-left: 0;
			border-bottom: 1px solid #e6eae8;
		}

		.note-properties__row:last-child {
			border-bottom: 0;
		}
	}
</style>
