---
import { ui } from "src/i18n";
import { formatUiDate } from "src/i18n/format";
import type { LibraryItem } from "src/lib/vault";
import { parseAppUrl, toRelativeAppUrl } from "src/lib/noteBrowserState";
import { getNoteTypeKickerLabel } from "src/lib/noteKickers";
import FavoriteToggleButton from "src/components/FavoriteToggleButton.astro";
import Icon from "src/components/Icon.astro";
import NoteMetadataDrawer from "src/components/notes/NoteMetadataDrawer.astro";
import NoteHeroTagPreview from "src/components/notes/NoteHeroTagPreview.astro";

interface Props {
	note: LibraryItem;
	heroStyle?: "none" | "cover" | "travel";
	summary?: string;
}

const { note, heroStyle = "none", summary = note.excerpt } = Astro.props;
const breadcrumb = note.relativePath.split("/").slice(0, -1).join(" / ");
const redirectTo = Astro.url.pathname + Astro.url.search;
const returnToUrl = parseAppUrl(Astro.url.searchParams.get("returnTo"));
const backHref = returnToUrl ? toRelativeAppUrl(returnToUrl) : "/notes";
const typeLabel = getNoteTypeKickerLabel(note.normalized.type, note.domainKey, note.domainLabel);
const tagLabels = note.tags.map((tag) => `#${tag}`);

function formatDate(value?: string) {
	if (!value) return null;
	const timestamp = Date.parse(value);
	return Number.isNaN(timestamp) ? value : formatUiDate(timestamp);
}

const createdLabel = formatDate(note.normalized.created);
const updatedLabel = formatDate(note.normalized.updated) ?? note.updatedLabel;
---

<div class="note-reader-shell" data-note-reader>
	<NoteMetadataDrawer note={note} />
	<div class="note-reader-stack" data-note-reader-content>
		{heroStyle === "travel" ? (
			<>
				<section class="surface-panel overflow-hidden border-[#e8e0d4] shadow-[0_18px_44px_rgba(15,23,42,0.06)]">
					<div class="relative min-h-[300px] md:min-h-[360px]">
						{note.imageUrl
							? <img src={note.imageUrl} alt="" class="absolute inset-0 h-full w-full object-cover" />
							: <div class="absolute inset-0 bg-[linear-gradient(135deg,#8fb6cb_0%,#ead9c1_100%)]"></div>}
						<div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(15,23,42,0.24)_0%,rgba(15,23,42,0.48)_48%,rgba(15,23,42,0.78)_100%)]"></div>
						<div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(251,191,36,0.16),_transparent_28%)]"></div>
						<div class="relative flex min-h-[300px] flex-col px-5 py-5 md:min-h-[360px] md:px-8 md:py-7">
							<div class="flex items-center justify-between gap-3">
								<a href={backHref} class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/16 bg-slate-950/24 text-white/92 backdrop-blur-sm transition hover:bg-slate-950/38" aria-label={ui.noteDetail.backToAllNotes}>
									<Icon name="chevron-left" class="h-4 w-4" />
								</a>
								<FavoriteToggleButton noteId={note.id} isFavorite={Boolean(note.favorite)} redirectTo={redirectTo} tone="dark" size="md" motionVariant="sunray" />
							</div>
							<div class="mt-auto space-y-4 md:space-y-5">
								{breadcrumb && <p class="text-sm font-medium text-white/68">{breadcrumb}</p>}
								<div class="flex flex-wrap items-center gap-2.5">
									<span class="rounded-[5px] border border-white/14 bg-white/10 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-white/88 backdrop-blur-sm">{note.domainLabel}</span>
									{typeLabel && <span class="rounded-[5px] border border-white/14 bg-slate-950/18 px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-white/78 backdrop-blur-sm">{typeLabel}</span>}
								</div>
								<h1 class="max-w-4xl text-[2rem] font-semibold tracking-[-0.045em] text-white sm:text-[2.45rem] md:text-5xl md:leading-[1.02]">{note.title}</h1>
								{summary && <p class="max-w-3xl text-[0.98rem] leading-7 text-white/76 md:text-[1.04rem] md:leading-8">{summary}</p>}
								<div class="flex flex-col gap-3.5 lg:flex-row lg:flex-wrap lg:items-center lg:justify-between">
									{tagLabels.length > 0 && <NoteHeroTagPreview values={tagLabels} variant="dark" />}
									<div class="flex flex-wrap gap-2 text-sm text-white/72">
										{createdLabel && <span>{ui.noteDetail.created} {createdLabel}</span>}
										<span>{ui.noteDetail.updated} {updatedLabel}</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</section>
				<slot />
			</>
		) : (
			<div class="note-reader-document">
				<header class="note-reader-hero">
					<div class="note-reader-toolbar">
						<div class="note-reader-actions">
							<a href={backHref} class="note-reader-action" aria-label={ui.noteDetail.backToAllNotes}>
								<Icon name="chevron-left" class="h-4 w-4" />
							</a>
							<FavoriteToggleButton noteId={note.id} isFavorite={Boolean(note.favorite)} redirectTo={redirectTo} size="md" motionVariant="sunray" />
						</div>
						<div class="note-reader-dates">
							{createdLabel && <span>{ui.noteDetail.created} {createdLabel}</span>}
							<span>{ui.noteDetail.updated} {updatedLabel}</span>
						</div>
					</div>

					<div class="note-reader-heading">
						{breadcrumb && <p class="note-reader-breadcrumb">{breadcrumb}</p>}
						<div class="note-reader-kickers">
							<span>{note.domainLabel}</span>
							{typeLabel && <span>{typeLabel}</span>}
						</div>
						<h1>{note.title}</h1>
						{summary && <p class="note-reader-summary">{summary}</p>}
						{tagLabels.length > 0 && <NoteHeroTagPreview values={tagLabels} />}
					</div>

					{heroStyle === "cover" && note.imageUrl && <div class="note-reader-cover"><img src={note.imageUrl} alt="" /></div>}
				</header>

				<div class="note-reader-document__body">
					<slot />
				</div>
			</div>
		)}
	</div>
</div>

<style>
	.note-reader-stack { padding-block: .75rem 2rem; }
	.note-reader-document { width: min(100%, 66rem); margin-inline: auto; overflow: hidden; border: 1px solid #dce3e5; border-radius: 14px; background: #fbfbf9; box-shadow: 0 16px 42px rgba(30, 41, 45, .055); }
	.note-reader-hero { border-bottom: 1px solid #e1e5e3; }
	.note-reader-toolbar { display: flex; min-height: 4rem; align-items: center; justify-content: space-between; gap: 1rem; padding: .65rem clamp(1rem, 4vw, 2rem); border-bottom: 1px solid #e7e9e6; }
	.note-reader-actions { display: flex; align-items: center; gap: .4rem; }
	.note-reader-action { display: grid; width: 2.6rem; height: 2.6rem; place-items: center; border-radius: 999px; color: #59666a; transition: background 160ms ease, color 160ms ease; }
	.note-reader-action:hover { background: #eef1ee; color: #1f2b2e; }
	.note-reader-action:focus-visible { outline: 2px solid #64816e; outline-offset: 3px; }
	.note-reader-dates { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .35rem 1rem; color: #788488; font-size: .68rem; }
	.note-reader-heading { width: min(100%, 49rem); margin-inline: auto; padding: 2rem clamp(1.25rem, 5vw, 2.75rem) 2.25rem; }
	.note-reader-breadcrumb { overflow: hidden; color: #7a878a; font-size: .66rem; letter-spacing: .04em; text-overflow: ellipsis; white-space: nowrap; }
	.note-reader-kickers { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1.35rem; }
	.note-reader-kickers span { border-left: 2px solid #789184; padding-left: .55rem; color: #50645a; font-size: .62rem; font-weight: 750; letter-spacing: .13em; text-transform: uppercase; }
	.note-reader-heading h1 { margin-top: 1rem; font-family: Georgia, "Times New Roman", serif; color: #1d2926; font-size: clamp(2.15rem, 6vw, 3.45rem); font-weight: 600; letter-spacing: -.04em; line-height: 1.03; overflow-wrap: anywhere; }
	.note-reader-summary { max-width: 44rem; margin-top: 1.15rem; color: #58676a; font-size: .98rem; line-height: 1.75; }
	.note-reader-heading :global([data-note-hero-tag-preview]) { margin-top: 1.25rem; }
	.note-reader-cover { width: min(100% - 2rem, 58rem); max-height: 24rem; margin: 0 auto 1.5rem; overflow: hidden; border-radius: 9px; }
	.note-reader-cover img { width: 100%; height: 100%; object-fit: cover; }
	.note-reader-document__body { width: min(100%, 49rem); margin-inline: auto; padding: 2.25rem clamp(1.25rem, 5vw, 2.75rem) 4rem; }
	.note-reader-toolbar :global(.favorite-toggle-form[data-favorite-variant="default"] .favorite-toggle-button) { border-color: transparent; background: transparent; box-shadow: none; color: #667277; }
	.note-reader-toolbar :global(.favorite-toggle-form[data-favorite-variant="default"] .favorite-toggle-button:hover) { background: #eef1ee; color: #1f2b2e; }
	@media (max-width: 639px) {
		.note-reader-stack { padding-block: 0 1rem; }
		.note-reader-document { border-radius: 10px; }
		.note-reader-toolbar { min-height: 3.5rem; }
		.note-reader-dates span:first-child:not(:last-child) { display: none; }
		.note-reader-heading { padding-top: 1.45rem; padding-bottom: 1.75rem; }
		.note-reader-document__body { padding-top: 1.75rem; padding-bottom: 2.75rem; }
	}
</style>
