---
import { ui } from "src/i18n";
import Icon from "src/components/Icon.astro";
import MotionBurst from "src/components/MotionBurst.astro";

interface Props {
	code: string;
}

const { code } = Astro.props;
---

<section class="dataview-card">
	<div class="dataview-card__header">
		<div>
			<p class="dataview-card__title">{ui.dataview.jsTitle}</p>
			<p class="dataview-card__subtitle">{ui.dataview.jsSubtitle}</p>
		</div>
		<button
			type="button"
			class="code-copy-button"
			data-copy-code
			data-motion-positive
			data-copy-value={code}
			aria-label={ui.common.copy}
			title={ui.common.copy}
		>
			<span data-motion-icon="default"><Icon name="copy" class="code-copy-button__icon" /></span>
			<span data-motion-icon="success"><Icon name="check" class="code-copy-button__icon" /></span>
			<MotionBurst variant="default" color="accent" />
		</button>
	</div>
	<pre class="code-block__pre"><code>{code.replace(/\n$/, "")}</code></pre>
</section>
