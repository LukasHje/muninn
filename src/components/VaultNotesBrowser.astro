---
import { formatUiNumber } from "src/i18n/format";
import { ui } from "src/i18n";
import Icon from "src/components/Icon.astro";
import NoteCard from "src/components/NoteCard.astro";
import NoteListRow from "src/components/NoteListRow.astro";
import SectionCard from "src/components/SectionCard.astro";
import TagMultiSelect from "src/components/TagMultiSelect.astro";
import { getNoteBrowserState } from "src/lib/noteBrowserState";
import { buildNoteSearchDocuments, searchNoteDocuments } from "src/lib/noteSearch";
import type { LibraryItem } from "src/lib/vault";

interface Props {
	title: string;
	items: LibraryItem[];
	emptyMessage: string;
	basePath?: string;
}

const {
	title,
	items,
	emptyMessage,
	basePath = Astro.url.pathname,
} = Astro.props;

const searchParams = Astro.url.searchParams;
const searchState = getNoteBrowserState(searchParams);
const { query, category: selectedCategory, tags: selectedTags, sort: sortBy, layout } = searchState;

const categories = Array.from(
	new Map(
		items.map((item) => [
			item.domainKey,
			{ value: item.domainKey, label: item.domainLabel },
		])
	).values()
);

const tagCounts = items.reduce((counts, item) => {
	for (const tag of item.tags) {
		counts.set(tag, (counts.get(tag) ?? 0) + 1);
	}

	return counts;
}, new Map<string, number>());

const tagOptions = Array.from(tagCounts.entries())
	.map(([value, count]) => ({
		value,
		count,
		countLabel: String(count),
	}))
	.sort((left, right) => {
		if (left.count !== right.count) {
			return right.count - left.count;
		}

		return left.value.localeCompare(right.value, "sv");
	});

const selectedTagSet = new Set(selectedTags);

const scopedItems = items
	.filter((item) => {
		const matchesCategory = selectedCategory === "all" || item.domainKey === selectedCategory;
		const matchesTag =
			selectedTags.length === 0 || item.tags.some((tag) => selectedTagSet.has(tag));
		return matchesCategory && matchesTag;
	});

const scopedItemsById = new Map(scopedItems.map((item) => [item.id, item]));
const queryResults = query ? searchNoteDocuments(buildNoteSearchDocuments(scopedItems), query) : [];
const queryResultMap = new Map(queryResults.map((result) => [result.id, result]));

const filteredItems = query
	? queryResults
		.map((result) => scopedItemsById.get(result.id))
		.filter((item): item is LibraryItem => Boolean(item))
	: scopedItems.sort((a, b) => {
		if (sortBy === "title") {
			return a.title.localeCompare(b.title, "sv");
		}
		return items.indexOf(a) - items.indexOf(b);
	});

const resultsCountLabel = formatUiNumber(filteredItems.length);
const selectedCategoryLabel =
	selectedCategory === "all"
		? null
		: categories.find((category) => category.value === selectedCategory)?.label ?? selectedCategory;
const activeControlCount =
	(query ? 1 : 0) + (selectedCategoryLabel ? 1 : 0) + selectedTags.length;
const collapsedControlSummary = [
	query ? `“${query}”` : null,
	selectedCategoryLabel,
	selectedTags.length === 1
		? `#${selectedTags[0]}`
		: selectedTags.length > 1
			? ui.notesBrowser.selectedTags(selectedTags.length)
			: null,
].filter((value): value is string => Boolean(value)).join(" · ") || ui.notesBrowser.searchAndFilters;

function buildLayoutHref(nextLayout: "list" | "grid") {
	const next = new URLSearchParams(searchParams);
	next.set("layout", nextLayout);
	return `${basePath}?${next.toString()}`;
}
---

<div
	class="flex h-full min-h-0 flex-col gap-3 md:gap-5 xl:gap-6"
	data-library-browser
>
	<section
		class="library-controls-panel surface-panel shrink-0 p-3 md:p-5"
		data-library-controls
		data-library-controls-collapsed="false"
	>
		<div class="library-controls-header flex items-center gap-3 border-b border-[#eee7de] px-1 pb-4">
			<a
				href="/"
				class="inline-flex h-11 w-11 items-center justify-center rounded-xl text-slate-500 transition hover:bg-[#f6f1ea] hover:text-slate-900"
				aria-label={ui.notesBrowser.backToDashboard}
			>
				<Icon name="chevron-left" class="h-4 w-4" />
			</a>
			<div class="min-w-0 flex-1">
				<h1 class="truncate text-lg font-semibold tracking-tight text-slate-900">{title}</h1>
				<p
					class="library-controls-summary mt-0.5 hidden truncate text-xs text-slate-500"
					title={collapsedControlSummary}
				>
					{collapsedControlSummary}
				</p>
			</div>
			<button
				type="button"
				class="library-controls-toggle relative hidden h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[#e7dfd5] bg-white text-slate-600 transition hover:border-[#ddd3c5] hover:bg-[#faf6ef] hover:text-slate-900"
				aria-controls="library-search-filter-controls"
				aria-expanded="true"
				aria-label={ui.notesBrowser.collapseSearchAndFilters}
				title={ui.notesBrowser.collapseSearchAndFilters}
				data-expand-label={ui.notesBrowser.expandSearchAndFilters}
				data-collapse-label={ui.notesBrowser.collapseSearchAndFilters}
				data-library-controls-toggle
			>
				<svg
					class="library-controls-icon-expanded h-5 w-5"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path d="M5 12h14"></path>
				</svg>
				<svg
					class="library-controls-icon-collapsed hidden h-5 w-5"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="m6 9 6 6 6-6"></path>
				</svg>
				{
					activeControlCount > 0 && (
						<span class="absolute -right-1.5 -top-1.5 inline-flex h-5 min-w-5 items-center justify-center rounded-full border-2 border-[#f6f2eb] bg-slate-900 px-1 text-[9px] font-semibold leading-none text-white">
							{activeControlCount}
						</span>
					)
				}
			</button>
		</div>

		<form
			id="library-search-filter-controls"
			method="get"
			class="library-controls-body space-y-3 pt-3 md:space-y-4 md:pt-4"
		>
			<input type="hidden" name="layout" value={layout} />
			<label class="block">
				<span class="sr-only">{ui.notesBrowser.searchNotes}</span>
				<span class="flex items-center gap-3 rounded-[14px] border border-[#e7dfd5] bg-white px-4 py-3 shadow-sm">
					<svg
						class="h-4 w-4 shrink-0 text-slate-400"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.8"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<circle cx="11" cy="11" r="7"></circle>
						<path d="m20 20-3.5-3.5"></path>
					</svg>
					<input
						class="min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-slate-400"
						type="search"
						name="q"
						value={query}
						placeholder={ui.notesBrowser.searchPlaceholder}
					/>
				</span>
			</label>

			<div class="flex flex-col gap-3 pt-1 lg:flex-row lg:items-center lg:justify-between lg:pt-2">
				<div class="grid grid-cols-2 gap-2.5 md:flex md:flex-wrap md:items-center md:gap-3">
					<label class="relative block min-w-0">
						<span class="sr-only">{ui.notesBrowser.category}</span>
						<select
							name="category"
							class="h-[46px] w-full appearance-none rounded-[12px] border border-[#e7dfd5] bg-white py-2.5 pl-4 pr-10 text-sm font-medium text-slate-700 shadow-sm outline-none transition focus:border-slate-300"
						>
							<option value="all" selected={selectedCategory === "all"}>{ui.notesBrowser.allCategories}</option>
							{
								categories.map((category) => (
									<option
										value={category.value}
										selected={selectedCategory === category.value}
									>
										{category.label}
									</option>
								))
							}
						</select>
						<Icon name="chevron-down" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
					</label>

					<TagMultiSelect
						name="tag"
						label={ui.notesBrowser.tag}
						allLabel={ui.notesBrowser.allTags}
						searchLabel={ui.notesBrowser.searchTags}
						searchPlaceholder={ui.notesBrowser.searchTagsPlaceholder}
						emptyLabel={ui.notesBrowser.noMatchingTags}
						selectedTags={selectedTags}
						options={tagOptions}
					/>

					<label class="relative block min-w-0">
						<span class="sr-only">{ui.notesBrowser.sort}</span>
						<select
							name="sort"
							class="h-[46px] w-full appearance-none rounded-[12px] border border-[#e7dfd5] bg-white py-2.5 pl-4 pr-10 text-sm font-medium text-slate-700 shadow-sm outline-none transition focus:border-slate-300"
						>
							<option value="updated" selected={sortBy === "updated"}>{ui.notesBrowser.sortByUpdated}</option>
							<option value="title" selected={sortBy === "title"}>{ui.notesBrowser.sortByTitle}</option>
						</select>
						<Icon name="chevron-down" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
					</label>

					<button
						type="submit"
						class="min-h-11 rounded-[12px] bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-800"
					>
						{ui.notesBrowser.filter}
					</button>
				</div>

				<div class="flex items-center gap-2">
					<a
						href={buildLayoutHref("list")}
						class:list={[
							"inline-flex h-11 w-11 items-center justify-center rounded-[12px] border shadow-sm transition",
							layout === "list"
								? "border-[#ddd3c5] bg-[#f4efe7] text-slate-900"
								: "border-[#e7dfd5] bg-white text-slate-500 hover:bg-[#faf6ef]",
						]}
						aria-label={ui.notesBrowser.listView}
					>
						<Icon name="layout-list" class="h-4 w-4" />
					</a>
					<a
						href={buildLayoutHref("grid")}
						class:list={[
							"inline-flex h-11 w-11 items-center justify-center rounded-[12px] border shadow-sm transition",
							layout === "grid"
								? "border-[#ddd3c5] bg-[#f4efe7] text-slate-900"
								: "border-[#e7dfd5] bg-white text-slate-500 hover:bg-[#faf6ef]",
						]}
						aria-label={ui.notesBrowser.gridView}
					>
						<Icon name="layout-grid" class="h-4 w-4" />
					</a>
				</div>
			</div>
		</form>
	</section>

	<SectionCard
		title={ui.notesBrowser.results}
		subtitle={ui.notesBrowser.resultsSubtitle(resultsCountLabel)}
		sectionClass="flex min-h-0 flex-1 flex-col overflow-hidden"
		bodyClass={[
			"vault-notes-results min-h-0 flex-1 overflow-y-auto overscroll-contain pr-1",
			layout === "grid" ? "" : "divide-y divide-[#efe8df]",
		].filter(Boolean).join(" ")}
	>
		{
			filteredItems.length === 0 ? (
				<div class="rounded-[16px] border border-dashed border-[#ddd3c5] bg-[#fbf7f1] px-5 py-8 text-sm text-slate-600">
					{emptyMessage}
				</div>
			) : layout === "grid" ? (
				<div class="grid gap-4 md:grid-cols-2 2xl:grid-cols-3">
					{
						filteredItems.map((item) => (
							<NoteCard
								item={item}
								selectedTags={selectedTags}
								searchQuery={query || undefined}
								searchSnippet={queryResultMap.get(item.id)?.snippet}
								searchField={queryResultMap.get(item.id)?.field}
								hrefOverride={queryResultMap.get(item.id)?.href}
							/>
						))
					}
				</div>
			) : (
				<div>
					{
						filteredItems.map((item) => (
							<NoteListRow
								item={item}
								selectedTags={selectedTags}
								searchQuery={query || undefined}
								searchSnippet={queryResultMap.get(item.id)?.snippet}
								searchField={queryResultMap.get(item.id)?.field}
								hrefOverride={queryResultMap.get(item.id)?.href}
							/>
						))
					}
				</div>
			)
		}
	</SectionCard>
</div>

<script>
	const LIBRARY_CONTROLS_STORAGE_KEY = "muninn:library-controls-collapsed";

	function initLibraryControls() {
		for (const root of document.querySelectorAll<HTMLElement>("[data-library-controls]")) {
			if (root.dataset.libraryControlsReady === "true") {
				continue;
			}

			const toggle = root.querySelector<HTMLButtonElement>("[data-library-controls-toggle]");
			if (!toggle) {
				continue;
			}

			root.dataset.libraryControlsReady = "true";
			const mobileViewport = window.matchMedia("(max-width: 1279px)");
			let prefersCollapsed = false;

			try {
				prefersCollapsed = window.sessionStorage.getItem(LIBRARY_CONTROLS_STORAGE_KEY) === "true";
			} catch {
				prefersCollapsed = false;
			}

			const applyState = () => {
				const collapsed = mobileViewport.matches && prefersCollapsed;
				root.dataset.libraryControlsCollapsed = collapsed ? "true" : "false";
				toggle.setAttribute("aria-expanded", collapsed ? "false" : "true");

				const label = collapsed
					? toggle.dataset.expandLabel ?? "Expand search and filters"
					: toggle.dataset.collapseLabel ?? "Collapse search and filters";
				toggle.setAttribute("aria-label", label);
				toggle.title = label;
			};

			toggle.addEventListener("click", () => {
				prefersCollapsed = root.dataset.libraryControlsCollapsed !== "true";

				try {
					window.sessionStorage.setItem(
						LIBRARY_CONTROLS_STORAGE_KEY,
						prefersCollapsed ? "true" : "false"
					);
				} catch {
					// The control remains functional when browser storage is unavailable.
				}

				applyState();
			});

			mobileViewport.addEventListener("change", applyState);
			document.addEventListener(
				"astro:before-swap",
				() => mobileViewport.removeEventListener("change", applyState),
				{ once: true }
			);
			applyState();
		}
	}

	initLibraryControls();
	document.addEventListener("astro:page-load", initLibraryControls);
</script>

<style>
	@media (max-width: 1279px) {
		.library-controls-toggle {
			display: inline-flex;
		}

		.library-controls-panel[data-library-controls-collapsed="true"] {
			padding-top: 0.65rem;
			padding-bottom: 0.65rem;
		}

		.library-controls-panel[data-library-controls-collapsed="true"] .library-controls-header {
			border-bottom-color: transparent;
			padding-bottom: 0;
		}

		.library-controls-panel[data-library-controls-collapsed="true"] .library-controls-summary {
			display: block;
		}

		.library-controls-panel[data-library-controls-collapsed="true"] .library-controls-body {
			display: none;
		}

		.library-controls-panel[data-library-controls-collapsed="true"] .library-controls-icon-expanded {
			display: none;
		}

		.library-controls-panel[data-library-controls-collapsed="true"] .library-controls-icon-collapsed {
			display: block;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.library-controls-toggle {
			transition-duration: 0.01ms;
		}
	}
</style>
