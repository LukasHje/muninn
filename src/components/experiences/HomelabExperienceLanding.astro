---
import ExperienceView from "src/components/experiences/ExperienceView.astro";
import HomelabDashboard from "src/components/experiences/HomelabDashboard.astro";
import HomelabExperienceHero from "src/components/experiences/HomelabExperienceHero.astro";
import type { ExperienceViewModel } from "src/lib/experiences/experience";
type Props = ExperienceViewModel;
const props = Astro.props;
---
<ExperienceView {...props} heroComponent={HomelabExperienceHero} showHeroBrowserControls={false}>
	<HomelabDashboard slot="dashboard" notes={props.notes} filterState={props.filterState} sortBy={props.sortBy} sortOrder={props.sortOrder} layout={props.layout} />
</ExperienceView>
