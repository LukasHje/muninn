---
import FavoriteToggleButton from "src/components/FavoriteToggleButton.astro";
import Icon from "src/components/Icon.astro";
import NoteContent from "src/components/notes/NoteContent.astro";
import { getInspectorFirstParagraph, type InspectorSection as InspectorSectionData } from "src/lib/experiences/inspector";
import { getRecipeMetadata, getRecipeServingPresentation } from "src/lib/experiences/recipes";
import type { ExperienceDefinition } from "src/lib/experiences/registry";
import { getExperienceMetadataEntries, getInspectorImage, getNoteSummary, isPlaceholderExperienceImage } from "src/lib/experiences/selectors";
import type { LibraryItem } from "src/lib/vault";

interface Props {
 definition: ExperienceDefinition;
 note: LibraryItem;
 sections: InspectorSectionData[];
 noteHref: string;
 redirectTo: string;
}
const { definition, note, sections, noteHref, redirectTo } = Astro.props;
const recipe = getRecipeMetadata(note);
const imageUrl = getInspectorImage(note, definition);
const isPlaceholderImage = isPlaceholderExperienceImage(imageUrl, definition);
const summary = getNoteSummary(note);
const serving = getRecipeServingPresentation(note, recipe.servings);
const facts = [
 { label: "Total time", value: recipe.totalTime },
 { label: "Preparation", value: recipe.prepTime },
 { label: "Cooking", value: recipe.cookTime },
 { label: serving.label, value: recipe.servings },
 { label: "Difficulty", value: recipe.difficulty },
].filter(fact => fact.value);
const details = getExperienceMetadataEntries(note, ["collection", "tags"]);
const context = [...new Set([recipe.cuisine, ...recipe.categories].filter(Boolean))].join(" · ");
function findSection(...titles: string[]) {
 return sections.find(section => titles.includes(section.title.trim().toLocaleLowerCase("en"))) ?? null;
}
const ingredients = findSection("ingredients", "ingredienser", "ingredienserna");
const method = findSection("instructions", "instruktioner", "method", "directions");
const notes = findSection("notes", "anteckningar", "review");
const notesPreview = notes
 ? { ...notes, content: getInspectorFirstParagraph(notes.content) }
 : null;
---
<div class="recipe-inspector">
 <div class="recipe-inspector__toolbar">
  <button type="button" data-experience-close aria-label="Close inspector"><Icon name="arrow-left" class="h-5 w-5" /></button>
  <span>THE KITCHEN / RECIPE</span>
  <div data-experience-inspector-favorite><FavoriteToggleButton noteId={note.id} isFavorite={Boolean(note.favorite)} redirectTo={redirectTo} size="md" variant="chromeless" /></div>
 </div>
 <div class="recipe-inspector__art">
  <div class="recipe-inspector__fallback" aria-hidden="true"><Icon name="chef-hat" class="h-16 w-16" /></div>
  {imageUrl && <img src={imageUrl} alt="" loading="lazy" class:list={[isPlaceholderImage && "recipe-inspector__placeholder"]} onerror="this.setAttribute('hidden', '')" />}
 </div>
 <div class="recipe-inspector__content">
  <header>
   <div class="recipe-inspector__eyebrow">
    <span>{context || "From your recipe collection"}</span>
    {recipe.status && <span class="recipe-inspector__badge">{recipe.status === "made" ? "Made" : "To try"}</span>}
   </div>
   <h1>{note.title}</h1>
   {recipe.rating !== null && <div class="recipe-inspector__rating" aria-label={`Rating: ${recipe.rating}`}><Icon name="star" filled class="h-4 w-4" /><span>{recipe.rating.toLocaleString("en")}</span></div>}
   {summary && <p class="recipe-inspector__summary">{summary}</p>}
   <a href={noteHref} data-experience-open-note data-note-href={noteHref} class="recipe-inspector__open">Open full recipe <Icon name="square-arrow-up-right" class="h-4 w-4" /></a>
  </header>
  {facts.length > 0 && <section class="recipe-inspector__section" aria-label="Recipe facts">
   <dl class="recipe-inspector__facts">{facts.map(fact => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>
  </section>}
  {(ingredients || recipe.ingredients.length > 0) && <section class="recipe-inspector__section">
   <h2>{ingredients?.title ?? "Ingredients"}</h2>
   {ingredients ? <NoteContent note={note} content={ingredients.content} /> : <ul class="recipe-inspector__ingredients">{recipe.ingredients.map(ingredient => <li>{ingredient}</li>)}</ul>}
  </section>}
  {method && <section class="recipe-inspector__section"><h2>{method.title}</h2><NoteContent note={note} content={method.content} /></section>}
  {notesPreview?.content && <section class="recipe-inspector__section"><h2>{notesPreview.title}</h2><NoteContent note={note} content={notesPreview.content} /></section>}
  {details.length > 0 && <section class="recipe-inspector__section"><h2>Recipe details</h2><dl class="recipe-inspector__details">{details.map(entry => <div><dt>{entry.label}</dt><dd>{entry.value}</dd></div>)}</dl></section>}
  <footer><span>From your vault</span><span>Updated {note.updatedLabel.toLowerCase()}</span></footer>
 </div>
</div>
<style>
 .recipe-inspector { min-height: 100%; background: var(--recipe-preview-surface, #fafaf8); color: #292f29; }
 .recipe-inspector__toolbar { display: flex; align-items: center; justify-content: space-between; gap: .6rem; padding: .55rem .8rem; color: #576052; }
 .recipe-inspector__toolbar > span { font-size: .6rem; letter-spacing: .15em; }
 .recipe-inspector__toolbar > button { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 6px; }
 .recipe-inspector__toolbar > button:hover { background: #e8ecdf; }
 .recipe-inspector__art { position: relative; aspect-ratio: 16/10; overflow: hidden; background: #edf0e7; }
 .recipe-inspector__fallback { position: absolute; inset: 0; display: grid; place-items: center; color: #576052; }
 .recipe-inspector__art img { position: relative; width: 100%; height: 100%; object-fit: cover; }
 .recipe-inspector__art img.recipe-inspector__placeholder { object-fit: contain; padding: 1.5rem; }
 .recipe-inspector__content { padding: 1.5rem clamp(1rem, 4vw, 1.75rem) 2rem; }
 .recipe-inspector__eyebrow { display: flex; align-items: center; justify-content: space-between; gap: .75rem; font-size: .65rem; line-height: 1.6; letter-spacing: .1em; text-transform: uppercase; color: #576052; overflow-wrap: anywhere; }
 .recipe-inspector__badge { flex-shrink: 0; padding: .25rem .55rem; border: 1px solid #85916e; border-radius: 4px; color: #42512f; background: #e8eddf; }
 h1 { margin-top: .75rem; font-family: Georgia, serif; font-size: clamp(1.8rem, 4vw, 2.4rem); line-height: 1.12; letter-spacing: -.025em; overflow-wrap: anywhere; }
 .recipe-inspector__rating { display: flex; align-items: center; gap: .4rem; margin-top: .8rem; font-size: .8rem; color: #795409; }
 .recipe-inspector__summary { margin-top: 1rem; font-size: .85rem; line-height: 1.8; color: #505c4d; }
 .recipe-inspector__open { display: flex; align-items: center; justify-content: space-between; gap: .75rem; min-height: 44px; margin-top: 1.35rem; padding: .7rem .9rem; border-radius: 6px; background: #e3e9d9; color: #35472b; font-size: .8rem; font-weight: 650; }
 .recipe-inspector__open:hover { background: #d7e0ca; }
 .recipe-inspector__section { margin-top: 1.6rem; padding-top: 1.3rem; border-top: 1px solid #d9dfd2; }
 h2 { margin-bottom: 1rem; font-size: .72rem; font-weight: 650; letter-spacing: .09em; text-transform: uppercase; color: #48583c; }
 .recipe-inspector__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.1rem; }
 dt { font-size: .72rem; color: #576052; }
 dd { overflow-wrap: anywhere; }
 .recipe-inspector__facts dd { margin-top: .3rem; font-size: 1rem; font-weight: 550; }
 .recipe-inspector__ingredients { padding-left: 1.2rem; list-style: disc; font-size: .85rem; line-height: 1.8; }
 .recipe-inspector__ingredients li + li { margin-top: .45rem; }
 .recipe-inspector__details > div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 1rem; padding: .45rem 0; }
 .recipe-inspector__details dd { font-size: .78rem; line-height: 1.6; color: #505c4d; }
 footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #d9dfd2; font-size: .65rem; color: #576052; }
 .recipe-inspector :is(button, a):focus-visible { outline: 2px solid #52653c; outline-offset: 3px; }
 .recipe-inspector__toolbar :global(.favorite-toggle-form[data-favorite-variant="chromeless"] .favorite-toggle-button) { color: #576052; }
 .recipe-inspector__toolbar :global(.favorite-toggle-form[data-favorite-variant="chromeless"][data-favorite-state="true"] .favorite-toggle-button) { color: #795409; }
 @media (max-width: 1279px) {
  .recipe-inspector__toolbar { position: sticky; top: 0; z-index: 30; border-bottom: 1px solid #d9dfd2; background: var(--recipe-preview-surface, #fafaf8); }
 }
</style>
