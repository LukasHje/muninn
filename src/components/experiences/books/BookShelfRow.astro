---
import shelfPlank from "src/assets/experiences/books/bookshelf-shelf.svg";
import Icon from "src/components/Icon.astro";

interface Props {
	id: string;
	title: string;
	empty: string;
}

	const { id, title, empty } = Astro.props;
---

<section class="book-shelf-row" data-book-shelf={id}>
	<header class="book-shelf-row__header">
		<div class="book-shelf-row__title">
			<Icon name="bookmark" />
			<h2>{title}</h2>
		</div>
		<button type="button" class="book-shelf-row__more" data-book-see-all={id} hidden>
			<span>See all</span>
			<Icon name="arrow-right" class="h-4 w-4" />
		</button>
	</header>
	<div class="book-shelf-row__stage">
		<div class="book-shelf-row__slots" data-book-shelf-track></div>
		<p class="book-shelf-row__empty" data-book-shelf-empty>{empty}</p>
		<img class="book-shelf-row__plank" src={shelfPlank.src} alt="" aria-hidden="true" />
	</div>
</section>

<style>
	.book-shelf-row[hidden] { display: none; }
	.book-shelf-row__header {
		position: relative;
		z-index: 5;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.85rem 2.6rem 0.45rem;
	}
	.book-shelf-row__title {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: #d4aa70;
	}
	.book-shelf-row__title :global(svg) {
		height: 1.18rem;
		width: 1.18rem;
		flex: 0 0 auto;
	}
	.book-shelf-row__header h2 {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.18rem;
		font-weight: 600;
		letter-spacing: -0.025em;
		color: #e9dcc9;
	}
	.book-shelf-row__stage {
		--book-shelf-plank-height: clamp(1rem, 2.2vw, 1.8rem);
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		min-height: 17.4rem;
		overflow: visible;
	}
	.book-shelf-row__stage::before,
	.book-shelf-row__stage::after {
		content: "";
		position: absolute;
		z-index: 1;
		left: calc(0px - var(--book-shelf-pillar-width));
		width: calc(100% + var(--book-shelf-pillar-width) + var(--book-shelf-pillar-width));
		pointer-events: none;
	}
	.book-shelf-row__stage::before {
		top: calc(100% - var(--book-shelf-plank-height));
		height: clamp(6rem, 16.8vw, 18.2rem);
		background: linear-gradient(
			to bottom,
			rgba(11, 13, 10, 0.82) 20%,
			rgba(11, 13, 10, 0.62) 30%,
			rgba(11, 13, 10, 0.36) 68%,
			rgba(11, 13, 10, 0) 100%
		);
	}
	.book-shelf-row:last-child .book-shelf-row__stage::before { height: 8rem; }
	.book-shelf-row__stage::after {
		bottom: var(--book-shelf-plank-height);
		height: clamp(4rem, 7.4vw, 8rem);
		background: linear-gradient(
			to bottom,
			rgba(11, 13, 10, 0) 0%,
			rgba(11, 13, 10, 0.36) 32%,
			rgba(11, 13, 10, 0.62) 70%,
			rgba(11, 13, 10, 0.82) 80%,
			rgba(11, 13, 10, 0.82) 100%
		);
	}
	.book-shelf-row__slots {
		position: relative;
		z-index: 4;
		grid-column: 1;
		grid-row: 1;
		display: grid;
		grid-template-columns: repeat(var(--book-shelf-slot-count, 1), minmax(0, var(--book-shelf-slot-width, 10rem)));
		min-width: 0;
		min-height: 17.4rem;
		align-items: flex-end;
		justify-content: space-evenly;
		gap: 0;
		overflow: hidden;
		padding: 0.45rem 0 calc(var(--book-shelf-plank-height) - 0.4rem);
	}
	.book-shelf-row__slots :global(.book-card-shell) {
		min-width: 0;
		width: 100%;
	}
	.book-shelf-row__empty {
		position: absolute;
		z-index: 4;
		inset: 0 1.5rem var(--book-shelf-plank-height);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 0.88rem;
		font-style: italic;
		color: #786d60;
	}
	.book-shelf-row__plank {
		z-index: 3;
		grid-column: 1;
		grid-row: 1;
		align-self: end;
		display: block;
		height: var(--book-shelf-plank-height);
		width: calc(100% + var(--book-shelf-pillar-width));
		max-width: none;
		transform: translateX(calc(0px - var(--book-shelf-pillar-overhang)));
		pointer-events: none;
	}
	.book-shelf-row__more {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		border: 0;
		background: transparent;
		padding: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 0.62rem;
		color: #d4aa70;
		cursor: pointer;
		transition: color 180ms ease, transform 180ms ease;
	}
	.book-shelf-row__more[hidden] { display: none; }
	.book-shelf-row__more:hover,
	.book-shelf-row__more:focus-visible {
		transform: translateX(2px);
		color: #f0c984;
	}
	.book-shelf-row__more:focus-visible { outline: 2px solid #a96f3d; outline-offset: 3px; }
	.book-shelf-row__more svg { width: .75rem; height: .75rem; }
	@media (max-width: 767px) {
		.book-shelf-row__stage { min-height: 15rem; }
		.book-shelf-row__slots {
			min-height: 15rem;
			gap: 0;
			padding-inline: 0;
		}
		.book-shelf-row__header { padding-inline: 2rem; }
	}
</style>
