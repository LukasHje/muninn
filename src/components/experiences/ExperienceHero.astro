---
import Icon from "src/components/Icon.astro";
import ExperienceStatistics from "src/components/experiences/ExperienceStatistics.astro";
import type { ExperienceDefinition } from "src/lib/experiences/registry";
import type { ExperienceStatistic } from "src/lib/experiences/statistics";

interface Props {
	definition: ExperienceDefinition;
	statistics: ExperienceStatistic[];
}

const { definition, statistics } = Astro.props;
---

<div class="relative flex min-h-[clamp(15rem,28dvh,20rem)] items-center">
	<div class="relative z-10 w-full max-w-3xl space-y-3 px-1 py-8 md:space-y-4 md:px-2">
		<div class="flex items-center gap-3 text-sm font-medium text-white/56">
			<span>Experiences</span>
			<span aria-hidden="true">/</span>
			<span class="text-white/78">{definition.title}</span>
		</div>

		<div class="flex items-start gap-3.5 md:gap-4">
			<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[18px] border border-white/24 bg-black/12 shadow-[0_8px_18px_rgba(0,0,0,0.08)] backdrop-blur-[2px] md:h-[4rem] md:w-[4rem] md:rounded-[22px]">
				<Icon name={definition.icons.hero} class="h-6 w-6 text-white/88 md:h-7 md:w-7" />
			</div>

			<div class="min-w-0 space-y-2.5">
				<h1 class="text-[2rem] font-semibold leading-none tracking-[-0.06em] text-white drop-shadow-sm md:text-[3.8rem] xl:text-[4.1rem] xl:leading-[0.92]">
					{definition.title}
				</h1>
				<p class="line-clamp-2 max-w-2xl text-[0.95rem] leading-6 text-white/78 md:line-clamp-none md:text-[1rem] md:leading-7">
					{definition.description}
				</p>
				<ExperienceStatistics items={statistics} tone="dark" />
			</div>
		</div>
	</div>
</div>

<div class="rounded-[10px] border border-white/18 bg-[#f7f2eb]/92 px-4 py-3 shadow-sm backdrop-blur-md md:px-5 xl:py-3">
	<slot />
</div>
