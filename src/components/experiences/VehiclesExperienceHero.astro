---
import type { ExperienceDefinition } from "src/lib/experiences/registry";

interface Props {
	definition: ExperienceDefinition;
}

const { definition } = Astro.props;
---

<div class="vehicles-hero relative min-h-[clamp(15rem,28dvh,20rem)]">
	<div class="relative z-10 flex min-h-[clamp(15rem,28dvh,20rem)] max-w-xl flex-col justify-center px-1 py-8 md:px-2">
		<h1 class="text-[3.35rem] font-semibold leading-[0.88] tracking-[-0.065em] text-white drop-shadow-sm md:text-[5rem]">
			{definition.title}
		</h1>
		<p class="mt-4 max-w-[31rem] text-sm leading-7 text-white/82 md:text-base">
			{definition.description}
		</p>
	</div>
</div>
