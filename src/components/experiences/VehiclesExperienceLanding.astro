---
import ExperienceView from "src/components/experiences/ExperienceView.astro";
import VehiclesDashboard from "src/components/experiences/VehiclesDashboard.astro";
import VehiclesExperienceHero from "src/components/experiences/VehiclesExperienceHero.astro";
import type { ExperienceViewModel } from "src/lib/experiences/experience";

type Props = ExperienceViewModel;

const props = Astro.props;
---

<ExperienceView {...props} heroComponent={VehiclesExperienceHero} showHeroBrowserControls={false}>
	<VehiclesDashboard
		slot="dashboard"
		definition={props.definition}
		notes={props.notes}
		filterState={props.filterState}
		sortBy={props.sortBy}
		sortOrder={props.sortOrder}
		layout={props.layout}
	/>
</ExperienceView>
