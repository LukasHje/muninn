---
import Icon from "src/components/Icon.astro";
import ExperienceBrowserControls from "src/components/experiences/ExperienceBrowserControls.astro";
import { buildHomelabDashboardModel } from "src/lib/experiences/homelab";
import type { ExperienceFilterState } from "src/lib/experiences/filters";
import type { ExperienceSortField, ExperienceSortOrder } from "src/lib/experiences/sorting";
import type { LibraryItem } from "src/lib/vault";
interface Props { notes: LibraryItem[]; filterState: ExperienceFilterState; sortBy: ExperienceSortField; sortOrder: ExperienceSortOrder; layout: "grid" | "list" }
const { notes, filterState, sortBy, sortOrder, layout } = Astro.props;
const model = buildHomelabDashboardModel(notes);
const serviceTotal = model.serviceSplit.reduce((total, item) => total + item.count, 0);
const nodeTotal = model.nodeDistribution.reduce((total, item) => total + item.count, 0);
const splitColors = ["#38bdf8", "#22d3ee", "#818cf8", "#34d399", "#f59e0b", "#f472b6", "#a78bfa", "#94a3b8"];
function distributionGradient(items: Array<{ count: number }>, total: number) {
	let cursor = 0;
	return items.length > 0 && total > 0 ? items.map((item, index) => {
		const start = cursor;
		const end = cursor + (item.count / total) * 100;
		cursor = end;
		return `${splitColors[index % splitColors.length]} ${start}% ${end}%`;
	}).join(",") : "#334155 0 100%";
}
const serviceGradient = distributionGradient(model.serviceSplit, serviceTotal);
const nodeGradient = distributionGradient(model.nodeDistribution, nodeTotal);
const maxPlatform = Math.max(...model.platformDistribution.map((item) => item.count), 1);
const maxCoverage = Math.max(...model.documentationCoverage.map((item) => item.count), 1);
function href(key: string, value: string | null) { const p = new URLSearchParams(Astro.url.searchParams); value ? p.set(`filter-${key}`, value) : p.delete(`filter-${key}`); p.delete("selected"); p.delete("inspector"); return `${Astro.url.pathname}?${p.toString()}#experience-library`; }
---
<section class="homelab-dashboard" aria-label="Homelab overview">
	<div class="homelab-stats-row">
		<section class="stat-panel distribution-panel"><p class="label">Node distribution</p><div class="distribution-layout"><div class="distribution-donut" style={`--distribution:${nodeGradient}`} aria-hidden="true"></div><div class="distribution-list">{model.nodeDistribution.slice(0, 5).map((item, index) => <div class="distribution-row"><span><i style={`background:${splitColors[index % splitColors.length]}`}></i>{item.label}</span><strong>{item.count}</strong></div>)}</div></div></section>
		<section class="stat-panel distribution-panel"><p class="label">Service distribution</p><div class="distribution-layout"><div class="distribution-donut" style={`--distribution:${serviceGradient}`} aria-hidden="true"></div><div class="distribution-list">{model.serviceSplit.slice(0, 5).map((item, index) => <a href={href("homelab_service_category", item.value)} aria-current={filterState.metadata.homelab_service_category === item.value ? "true" : undefined} class="distribution-row"><span><i style={`background:${splitColors[index % splitColors.length]}`}></i>{item.label}</span><strong>{item.count}</strong></a>)}</div></div></section>
		<section class="stat-panel bars-panel"><p class="label">Platform distribution</p><div class="compact-bars">{model.platformDistribution.slice(0, 5).map((item) => <div class="compact-bar"><span>{item.label}</span><i><b style={`width:${(item.count / maxPlatform) * 100}%`}></b></i><strong>{item.count}</strong></div>)}</div></section>
		<section class="stat-panel bars-panel"><p class="label">Documentation coverage</p><div class="compact-bars">{model.documentationCoverage.slice(0, 5).map((item) => <div class="compact-bar"><span>{item.label}</span><i><b style={`width:${(item.count / maxCoverage) * 100}%`}></b></i><strong>{item.count}</strong></div>)}</div></section>
		{model.storageOverview && <section class="stat-panel storage-panel"><p class="label">Storage overview</p><div class="storage-grid"><span><strong>{model.storageOverview.pools}</strong>Pools</span><span><strong>{model.storageOverview.arrays}</strong>Arrays</span><span><strong>{model.storageOverview.totalStorage}</strong>Total</span><span><strong>{model.storageOverview.nas}</strong>NAS</span></div></section>}
		<section class="stat-panel technologies-panel"><p class="label">Technologies</p><div class="technologies-scroll" aria-label="Documented technologies">{model.technologies.map((item) => <span class="technology-badge">{item.label} <strong>{item.count}</strong></span>)}</div><p class="stat-helper"><span>{model.technologies.length} detected</span><Icon name="cpu" class="h-4 w-4 text-sky-400" /></p></section>
	</div>

	<div class="homelab-controls-row">
		<nav class="homelab-filter-panel" aria-label="Homelab filters"><a href={href("homelab_entity", null)} class:list={["filter", !filterState.metadata.homelab_entity && "active"]}><Icon name="layout-grid" class="h-3.5 w-3.5" />All</a>{model.entities.map((item) => <a href={href("homelab_entity", item.entity)} class:list={["filter", filterState.metadata.homelab_entity === item.entity && "active"]}>{item.entity} <span>{item.count}</span></a>)}</nav>
		<div class="homelab-browser-controls"><ExperienceBrowserControls sortBy={sortBy} sortOrder={sortOrder} layout={layout} /></div>
	</div>
</section>
<style>
	.homelab-dashboard{display:grid;gap:.35rem;min-width:0;color:#e2e8f0}.homelab-stats-row{display:flex;height:7.45rem;gap:.65rem;min-width:0;overflow-x:auto;overflow-y:hidden;overscroll-behavior-x:contain;scrollbar-width:none;-ms-overflow-style:none}.homelab-stats-row::-webkit-scrollbar{display:none}.stat-panel{display:flex;height:7.45rem;min-width:16rem;flex:none;flex-direction:column;overflow:hidden;border:1px solid rgba(71,102,126,.58);border-radius:10px;background:linear-gradient(145deg,rgba(16,29,41,.96),rgba(10,19,28,.94));padding:.65rem .8rem;box-shadow:0 8px 22px rgba(2,8,16,.16)}.label{flex:none;font-size:9px;font-weight:750;line-height:1.15;text-transform:uppercase;letter-spacing:.15em;color:#7dd3fc}.stat-helper{display:flex;flex:none;align-items:center;justify-content:space-between;gap:.3rem;font-size:10px;line-height:1.15;color:#64748b}
	.distribution-panel{min-width:17rem}.distribution-layout{display:grid;min-height:0;flex:1;grid-template-columns:3.9rem minmax(0,1fr);align-items:center;gap:.75rem;padding-top:.25rem}.distribution-donut{position:relative;width:3.9rem;aspect-ratio:1;border-radius:999px;background:conic-gradient(var(--distribution));box-shadow:inset 0 0 0 1px rgba(125,211,252,.12)}.distribution-donut::after{content:"";position:absolute;inset:.72rem;border-radius:999px;background:#14202c;box-shadow:0 0 0 1px rgba(71,102,126,.45)}.distribution-list{display:grid;height:100%;min-width:0;align-content:space-evenly}.distribution-row{display:flex;min-width:0;align-items:center;justify-content:space-between;gap:.35rem;border-radius:5px;padding:.08rem .25rem;font-size:9px;line-height:1.2;color:#94a3b8;transition:background 160ms,color 160ms}.distribution-row:hover,.distribution-row[aria-current="true"]{background:rgba(14,165,233,.12);color:#bae6fd}.distribution-row>span{display:flex;min-width:0;align-items:center;gap:.28rem;white-space:nowrap}.distribution-row i{display:block;width:.38rem;height:.38rem;flex:none;border-radius:999px}.distribution-row strong{font-size:9px;color:#e2e8f0;white-space:nowrap}
	.bars-panel{min-width:17rem}.compact-bars{display:grid;min-height:0;flex:1;align-content:space-evenly;padding-top:.2rem}.compact-bar{display:grid;grid-template-columns:5.5rem minmax(3rem,1fr) 1.1rem;align-items:center;gap:.35rem;font-size:9px;line-height:1.2;color:#94a3b8}.compact-bar span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.compact-bar i{height:.28rem;overflow:hidden;border-radius:999px;background:rgba(51,65,85,.75)}.compact-bar b{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#0ea5e9,#67e8f9)}.compact-bar strong{text-align:right;color:#e2e8f0}.storage-panel{min-width:14rem}.storage-grid{display:grid;min-height:0;flex:1;grid-template-columns:repeat(2,minmax(0,1fr));align-content:space-evenly;gap:.3rem;padding-top:.2rem}.storage-grid span{display:flex;flex-direction:column;border-left:1px solid rgba(71,102,126,.58);padding-left:.55rem;font-size:8px;line-height:1.15;text-transform:uppercase;letter-spacing:.08em;color:#64748b}.storage-grid strong{font-size:15px;line-height:1.15;text-transform:none;letter-spacing:0;color:#e2e8f0}
	.technologies-panel{min-width:18rem}.technologies-scroll{display:flex;min-height:0;min-width:0;max-width:100%;flex:1;align-items:center;overflow-x:auto;gap:.3rem;scrollbar-width:none}.technologies-scroll::-webkit-scrollbar{display:none}.technology-badge{display:inline-flex;flex:none;align-items:center;gap:.25rem;border:1px solid rgba(14,116,144,.7);border-radius:999px;background:rgba(8,47,73,.48);padding:.28rem .55rem;font-size:9px;font-weight:650;line-height:1.15;white-space:nowrap;color:#bae6fd}.technology-badge strong{color:#38bdf8}.homelab-controls-row{display:flex;min-width:0;align-items:center;justify-content:space-between;gap:.65rem}.homelab-filter-panel,.homelab-browser-controls{display:flex;min-width:0;align-items:center;border:1px solid rgba(71,102,126,.58);border-radius:9px;background:rgba(10,19,28,.92);padding:.32rem;box-shadow:0 6px 18px rgba(2,8,16,.14)}.homelab-filter-panel{gap:.28rem;overflow-x:auto;scrollbar-width:none}.homelab-filter-panel::-webkit-scrollbar{display:none}.filter{display:inline-flex;flex:none;align-items:center;gap:.35rem;border:1px solid transparent;border-radius:7px;padding:.44rem .68rem;font-size:10px;font-weight:650;text-transform:capitalize;white-space:nowrap;color:#94a3b8;transition:all 160ms}.filter:hover,.filter.active{border-color:#0ea5e9;background:rgba(14,165,233,.12);color:#bae6fd}.filter span{color:#64748b}.homelab-browser-controls{flex:none;--experience-sort-border:rgba(71,102,126,.72);--experience-sort-background:rgba(15,27,39,.86);--experience-sort-shadow:none;--experience-layout-button-background:rgba(20,36,50,.84);--experience-control-color:#94a3b8;--experience-control-hover-border:rgba(56,189,248,.5);--experience-control-hover-background:rgba(14,165,233,.12);--experience-control-hover-color:#bae6fd;--experience-control-active-border:rgba(56,189,248,.72);--experience-control-active-background:rgba(14,165,233,.2);--experience-control-active-color:#e0f2fe}
	@media(max-width:639px){.homelab-controls-row{align-items:stretch;flex-direction:column}.homelab-filter-panel{width:100%}.homelab-browser-controls{align-self:flex-end}}
</style>
