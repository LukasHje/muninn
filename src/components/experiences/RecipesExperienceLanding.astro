---
import ExperienceView from "src/components/experiences/ExperienceView.astro";
import RecipesDashboard from "src/components/experiences/RecipesDashboard.astro";
import RecipesExperienceHero from "src/components/experiences/RecipesExperienceHero.astro";
import type { ExperienceViewModel } from "src/lib/experiences/experience";

type Props = ExperienceViewModel;

const props = Astro.props;
---

<ExperienceView {...props} heroComponent={RecipesExperienceHero} showHeroBrowserControls={false}>
	<RecipesDashboard
		slot="dashboard"
		notes={props.notes}
		filterState={props.filterState}
		sortBy={props.sortBy}
		sortOrder={props.sortOrder}
		layout={props.layout}
	/>
</ExperienceView>
