---
import FavoriteToggleButton from "src/components/FavoriteToggleButton.astro";
import Icon from "src/components/Icon.astro";
import type { ExperienceDefinition } from "src/lib/experiences/registry";
import { getRecipeMetadata, getRecipeServingPresentation } from "src/lib/experiences/recipes";
import {
	getCardImage,
	getExperienceContextTags,
	isPlaceholderExperienceImage,
} from "src/lib/experiences/selectors";
import type { LibraryItem } from "src/lib/vault";

interface Props {
	definition: ExperienceDefinition;
	note: LibraryItem;
	selected?: boolean;
	redirectTo?: string;
}

const {
	definition,
	note,
	selected = false,
	redirectTo = Astro.url.pathname + Astro.url.search,
} = Astro.props;
const imageUrl = getCardImage(note, definition);
const isPlaceholderImage = isPlaceholderExperienceImage(imageUrl, definition);
const recipe = getRecipeMetadata(note);
const servingPresentation = getRecipeServingPresentation(note, recipe.servings);
const time = recipe.totalTime ?? recipe.cookTime ?? recipe.prepTime;
const tags = Array.from(
	new Set([
		...recipe.categories,
		...(recipe.cuisine ? [recipe.cuisine] : []),
		...getExperienceContextTags(note, 2),
	])
).slice(0, 2);

type RecipeFact = { iconName: string; value: string; label: string; filled?: boolean };
const isRecipeFact = (fact: RecipeFact | null): fact is RecipeFact => fact !== null;
const recipeFactCandidates: Array<RecipeFact | null> = [
	recipe.rating !== null
		? {
				iconName: "star",
				value: recipe.rating.toFixed(recipe.rating % 1 === 0 ? 0 : 1),
				label: "Rating",
				filled: true,
			}
		: null,
	recipe.servings
		? {
				iconName: servingPresentation.icon,
				value: recipe.servings,
				label: servingPresentation.label,
			}
		: null,
	time ? { iconName: "clock-3", value: time, label: "Time" } : null,
];
const recipeFacts = recipeFactCandidates.filter(isRecipeFact);
const statusPresentation = recipe.status === "made"
	? { label: "Made", icon: "circle-check", className: "recipe-card__status--made" }
	: recipe.status === "to-try"
		? { label: "To try", icon: "circle", className: "recipe-card__status--to-try" }
		: null;
---

<article
	data-selected={selected ? "true" : "false"}
	class="recipe-card group relative overflow-hidden rounded-[10px] border border-[#e1d3c3] bg-[#fffdf9]"
>
	<div class="recipe-card__favorite absolute right-2 top-2 z-20">
		<FavoriteToggleButton
			noteId={note.id}
			isFavorite={Boolean(note.favorite)}
			redirectTo={redirectTo}
			tone="dark"
			variant="chromeless"
			size="sm"
		/>
	</div>

	<button
		type="button"
		class="recipe-card__trigger block h-full w-full text-left"
		data-experience-card={note.id}
		aria-controls="experience-inspector-panel"
		aria-label={`Inspect ${note.title}`}
		aria-pressed={selected ? "true" : "false"}
	>
		<div
			class:list={[
				"recipe-card__image relative aspect-[4/3] overflow-hidden border-b border-[#eadfd3] bg-[#f0e4d5]",
				(!imageUrl || isPlaceholderImage) && "flex items-center justify-center p-6",
			]}
		>
			{
				imageUrl ? (
					<img
						src={imageUrl}
						alt=""
						class:list={[
							"h-full w-full transition duration-300",
							isPlaceholderImage
								? "object-contain opacity-70 mix-blend-multiply"
								: "object-cover group-hover:scale-[1.025]",
						]}
						loading="lazy"
					/>
				) : (
					<Icon name="chef-hat" class="h-12 w-12 text-amber-700/45" />
				)
			}
		</div>

		<div class="recipe-card__copy px-3.5 pb-3 pt-3">
			<h2 class="truncate text-[0.95rem] font-semibold tracking-[-0.025em] text-slate-900">{note.title}</h2>

			{
				tags.length > 0 && (
					<div class="mt-2 flex min-w-0 items-center gap-1.5 overflow-hidden">
						{tags.map((tag, index) => (
							<span
								class:list={[
									"max-w-[8.5rem] truncate rounded-[4px] px-1.5 py-0.5 text-[9px] font-semibold",
									index === 0
										? "bg-amber-100 text-amber-800"
										: "bg-slate-100 text-slate-600",
								]}
							>
								{tag}
							</span>
						))}
					</div>
				)
			}

			{
				recipeFacts.length > 0 && (
					<div class="mt-3 flex min-w-0 items-center gap-x-3 overflow-hidden text-[10px] font-medium text-slate-600">
						{recipeFacts.map((fact) => (
							<span
								class="flex min-w-0 items-center gap-1"
								title={`${fact.label}: ${fact.value}`}
								aria-label={`${fact.label}: ${fact.value}`}
							>
								<Icon
									name={fact.iconName}
									filled={fact.filled}
									class="h-3.5 w-3.5 shrink-0 text-amber-600"
								/>
								<span class="truncate tabular-nums">{fact.value}</span>
							</span>
						))}
					</div>
				)
			}

			<div class="mt-3 min-h-[1.85rem] border-t border-[#eadfd3] pt-2.5">
				{
					statusPresentation && (
						<span class:list={["recipe-card__status", statusPresentation.className]}>
							<Icon name={statusPresentation.icon} class="h-3 w-3" />
							{statusPresentation.label}
						</span>
					)
				}
			</div>
		</div>
	</button>
</article>

<style>
	.recipe-card {
		box-shadow: 0 14px 34px rgba(77, 48, 25, 0.065);
		transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
	}

	.recipe-card:hover,
	.recipe-card[data-selected="true"] {
		border-color: rgba(194, 126, 61, 0.72);
		box-shadow: 0 18px 38px rgba(77, 48, 25, 0.1);
		transform: translateY(-1px);
	}

	.recipe-card__status {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.62rem;
		font-weight: 650;
	}

	.recipe-card__status--made {
		color: #3f7651;
	}

	.recipe-card__status--to-try {
		color: #8a6a32;
	}

	:global([data-experience-layout="list"]) .recipe-card {
		min-height: 6rem;
		border-radius: 8px;
		box-shadow: 0 5px 16px rgba(77, 48, 25, 0.045);
	}

	:global([data-experience-layout="list"]) .recipe-card__trigger {
		display: grid;
		min-height: 6rem;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		align-items: stretch;
		padding-right: 3rem;
	}

	:global([data-experience-layout="list"]) .recipe-card__image {
		height: 100%;
		min-height: 6rem;
		aspect-ratio: auto;
		border-right: 1px solid #eadfd3;
		border-bottom: 0;
	}

	:global([data-experience-layout="list"]) .recipe-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	:global([data-experience-layout="list"]) .recipe-card__copy {
		display: flex;
		min-width: 0;
		flex-direction: column;
		justify-content: center;
		padding: 0.65rem 0.75rem;
	}

	:global([data-experience-layout="list"]) .recipe-card__copy > :global(* + *) {
		margin-top: 0.38rem;
	}

	:global([data-experience-layout="list"]) .recipe-card__copy > :last-child {
		min-height: 0;
		border-top: 0;
		padding-top: 0;
	}

	:global([data-experience-layout="list"]) .recipe-card__favorite {
		top: 0.65rem;
		right: 0.65rem;
		transform: none;
	}

	:global([data-experience-layout="list"]) .recipe-card__favorite :global(.favorite-toggle-button) {
		width: 2rem;
		height: 2rem;
	}

	:global([data-experience-layout="list"]) .recipe-card__favorite :global(svg) {
		width: 1.15rem;
		height: 1.15rem;
	}

	@media (min-width: 40rem) {
		:global([data-experience-layout="list"]) .recipe-card__trigger {
			grid-template-columns: 8rem minmax(0, 1fr);
			padding-right: 3.75rem;
		}

		:global([data-experience-layout="list"]) .recipe-card__copy {
			padding-right: 1rem;
			padding-left: 1rem;
		}

		:global([data-experience-layout="list"]) .recipe-card__favorite {
			top: 0.75rem;
			right: 0.9rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.recipe-card,
		.recipe-card img {
			transition-duration: 0.01ms;
		}
	}
</style>
