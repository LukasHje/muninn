---
import Icon from "src/components/Icon.astro";
interface Props { src: string | null; category: string; icon: string; }
const { src, category, icon } = Astro.props;
---
<div class="vehicle-artwork">
 <div class="vehicle-artwork__fallback" aria-hidden="true"><Icon name={icon} class="h-20 w-20" /><span>{category}</span></div>
 {src && <img src={src} alt="" loading="lazy" onerror="this.setAttribute('hidden', '')" />}
</div>
<style>
 .vehicle-artwork { position: relative; width: 100%; aspect-ratio: 16/10; overflow: hidden; background: #e9efeb; }
 .vehicle-artwork__fallback { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; color: #52645b; background: #e9efeb; }
 .vehicle-artwork__fallback span { font-size: .65rem; letter-spacing: .2em; text-transform: uppercase; }
 img { position: relative; width: 100%; height: 100%; object-fit: cover; }
</style>
