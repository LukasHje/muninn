---
import Icon from "src/components/Icon.astro";
import type { ExperienceDefinition } from "src/lib/experiences/registry";
import { getCardImage, isPlaceholderExperienceImage } from "src/lib/experiences/selectors";
import type { LibraryItem } from "src/lib/vault";

interface Item {
	note: LibraryItem;
	meta: string;
}

interface Props {
	definition: ExperienceDefinition;
	items: Item[];
	emptyLabel?: string;
}

const { definition, items, emptyLabel = "Notes appear here as the collection grows." } = Astro.props;
---

{
	items.length > 0 ? (
		<div class="divide-y divide-[#eadfd2] px-2.5">
			{items.slice(0, 3).map(({ note, meta }) => {
				const imageUrl = getCardImage(note, definition);
				const isPlaceholder = isPlaceholderExperienceImage(imageUrl, definition);
				return (
					<button
						type="button"
						class="group flex w-full items-center gap-2.5 py-2 text-left"
						data-experience-card={note.id}
						aria-controls="experience-inspector-panel"
						aria-label={`Inspect ${note.title}`}
						aria-pressed="false"
					>
						<div class="flex h-9 w-11 shrink-0 items-center justify-center overflow-hidden rounded-[5px] bg-[#eee3d5]">
							{imageUrl ? (
								<img
									src={imageUrl}
									alt=""
									class:list={["h-full w-full", isPlaceholder ? "object-contain p-1 opacity-70" : "object-cover"]}
									loading="lazy"
								/>
							) : (
								<Icon name={definition.icons.hero} class="h-4 w-4 text-slate-400" />
							)}
						</div>
						<div class="min-w-0 flex-1">
							<p class="truncate text-xs font-semibold text-slate-800 transition group-hover:text-amber-800">{note.title}</p>
							<p class="mt-0.5 truncate text-[10px] text-slate-400">{meta}</p>
						</div>
						<Icon name="chevron-right" class="h-3.5 w-3.5 shrink-0 text-slate-300" />
					</button>
				);
			})}
		</div>
	) : (
		<p class="p-3 text-xs leading-5 text-slate-500">{emptyLabel}</p>
	)
}
