---
interface Props {
	label?: string;
}

const { label = "Experience dashboard" } = Astro.props;
---

<div class="experience-dashboard" aria-label={label}>
	<div class="experience-dashboard__track">
		<slot />
	</div>
</div>

<style>
	.experience-dashboard {
		min-width: 0;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x proximity;
		scrollbar-width: thin;
		scrollbar-color: rgba(180, 126, 68, 0.34) transparent;
	}

	.experience-dashboard::-webkit-scrollbar {
		height: 4px;
	}

	.experience-dashboard::-webkit-scrollbar-thumb {
		border-radius: 999px;
		background: rgba(180, 126, 68, 0.34);
	}

	.experience-dashboard__track {
		display: grid;
		grid-auto-columns: minmax(15.5rem, 19rem);
		grid-auto-flow: column;
		gap: 0.75rem;
		width: max-content;
		min-width: 100%;
		padding: 0 0 0.35rem;
	}

	@media (min-width: 768px) {
		.experience-dashboard__track {
			grid-auto-columns: minmax(17rem, 21rem);
			gap: 0.9rem;
		}
	}
</style>
