---
import Icon from "src/components/Icon.astro";
import ExperienceStatistics from "src/components/experiences/ExperienceStatistics.astro";
import type { ExperienceDefinition } from "src/lib/experiences/registry";
import type { ExperienceStatistic } from "src/lib/experiences/statistics";

interface Props {
	definition: ExperienceDefinition;
	statistics: ExperienceStatistic[];
}

const { definition, statistics } = Astro.props;
---

<div class="relative flex min-h-[clamp(15rem,28dvh,20rem)] items-center">
	<div class="relative z-10 w-full max-w-3xl space-y-3 px-1 py-8 md:space-y-5 md:px-2">
		<div class="flex items-start gap-4">
			<div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-white/24 bg-black/12 shadow-[0_8px_20px_rgba(0,0,0,0.08)] backdrop-blur-[2px] md:h-14 md:w-14">
				<Icon name={definition.icons.hero} class="h-6 w-6 text-white/88 md:h-7 md:w-7" />
			</div>
			<div class="min-w-0">
				<p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/62">Experience</p>
				<h1 class="experience-hero-title mt-1 text-[2rem] font-semibold leading-none tracking-[-0.045em] text-white drop-shadow-sm md:text-[3.2rem]">
					{definition.title}
				</h1>
				<p class="experience-hero-description mt-2 line-clamp-2 max-w-2xl text-sm leading-6 text-white/78 md:mt-3 md:line-clamp-none md:leading-7">{definition.description}</p>
			</div>
		</div>
		<ExperienceStatistics items={statistics} tone="dark" />
	</div>
</div>

<div class="rounded-[10px] border border-white/18 bg-[#f7f2eb]/92 px-4 py-3 shadow-sm backdrop-blur-md md:px-5">
	<slot />
</div>
