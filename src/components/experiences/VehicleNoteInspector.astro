---
import FavoriteToggleButton from "src/components/FavoriteToggleButton.astro";
import Icon from "src/components/Icon.astro";
import InspectorHeader from "src/components/experiences/InspectorHeader.astro";
import InspectorSection from "src/components/experiences/InspectorSection.astro";
import MetadataRow from "src/components/experiences/MetadataRow.astro";
import StatusBadge from "src/components/experiences/StatusBadge.astro";
import NoteContent from "src/components/notes/NoteContent.astro";
import { getInspectorFirstParagraph, type InspectorSection as InspectorSectionData } from "src/lib/experiences/inspector";
import type { ExperienceDefinition } from "src/lib/experiences/registry";
import {
	getExperienceMetadataEntries,
	getInspectorImage,
	getNoteSummary,
	isPlaceholderExperienceImage,
} from "src/lib/experiences/selectors";
import {
	formatVehicleStatus,
	getVehicleCategoryIcon,
	getVehicleMetadata,
	getVehicleTitleParts,
	resolveVehiclePlaceholderThumbnail,
} from "src/lib/experiences/vehicles";
import type { LibraryItem } from "src/lib/vault";

interface Props {
	definition: ExperienceDefinition;
	note: LibraryItem;
	sections: InspectorSectionData[];
	noteHref: string;
	redirectTo: string;
}

const { definition, note, sections, noteHref, redirectTo } = Astro.props;
const vehicle = getVehicleMetadata(note);
const titleParts = getVehicleTitleParts(note);
const statusLabel = formatVehicleStatus(vehicle.status);
const metadataEntries = getExperienceMetadataEntries(note, definition.inspectorMetadata).map((entry) =>
	entry.key === "body_style" || entry.key === "model"
		? {
				...entry,
				icon: {
					...entry.icon,
					name: getVehicleCategoryIcon(vehicle.bodyStyle ?? entry.value),
				},
			}
		: entry
);
const placeholderThumbnail = resolveVehiclePlaceholderThumbnail(definition, vehicle.bodyStyle);
const imageUrl = getInspectorImage(note, definition, placeholderThumbnail);
const isPlaceholderImage = isPlaceholderExperienceImage(imageUrl, definition);
const isCategoryPlaceholderImage = Boolean(
	imageUrl
	&& imageUrl === placeholderThumbnail
	&& placeholderThumbnail !== definition.assets.placeholderThumbnail
);
const summary = getNoteSummary(note);

function findSection(...titles: string[]) {
	const normalizedTitles = titles.map((title) => title.toLocaleLowerCase("en"));
	return sections.find((section) => normalizedTitles.includes(section.title.trim().toLocaleLowerCase("en"))) ?? null;
}

const specsSection = findSection("Specs", "Specifications");
const ownershipSection = findSection("Ownership", "Planning");
const maintenanceSection = findSection("Maintenance");
const notesSection = findSection("Notes", "Review");
const filesSection = findSection("Files", "Attachments");
const previewSections = [
	specsSection ? { section: specsSection, icon: "sliders-horizontal" } : null,
	ownershipSection ? { section: ownershipSection, icon: "users" } : null,
	maintenanceSection ? { section: maintenanceSection, icon: "clipboard-list" } : null,
	notesSection ? { section: notesSection, icon: "notebook-pen" } : null,
	filesSection ? { section: filesSection, icon: "archive" } : null,
].filter(Boolean) as Array<{ section: InspectorSectionData; icon: string }>;
---

<div class="vehicle-inspector px-5 pb-9 md:px-6">
	<InspectorHeader title={titleParts.title}>
		<Fragment slot="leading">
			<button type="button" data-experience-close class="vehicle-inspector-action" aria-label="Close inspector" title="Close inspector">
				<Icon name="arrow-left" class="h-6 w-6" />
			</button>
		</Fragment>
		<Fragment slot="actions">
			<div class="flex items-center gap-2">
				<div data-experience-inspector-favorite>
					<FavoriteToggleButton
						noteId={note.id}
						isFavorite={Boolean(note.favorite)}
						redirectTo={redirectTo}
						size="md"
						variant="chromeless"
					/>
				</div>
				<a
					href={noteHref}
					data-experience-open-note
					data-note-href={noteHref}
					class="vehicle-inspector-action"
					aria-label="Open full vehicle note"
					title="Open full vehicle note"
				>
					<Icon name="square-arrow-up-right" class="h-6 w-6" />
				</a>
			</div>
		</Fragment>
	</InspectorHeader>

	<div class="mt-2 flex items-center justify-between gap-3">
		{titleParts.subtitle && <p class="truncate text-sm text-slate-500">{titleParts.subtitle}</p>}
		{statusLabel && <StatusBadge value={statusLabel} tone={definition.theme} />}
	</div>

	<div class="relative mt-4 overflow-hidden rounded-[10px] border border-[#d9c6a8] bg-[#eee0cf]">
		<div class="aspect-[16/9]">
			{
				imageUrl ? (
					<img
						src={imageUrl}
						alt=""
						class:list={[
							"h-full w-full",
							isPlaceholderImage && !isCategoryPlaceholderImage
								? "object-contain p-8 opacity-70 mix-blend-multiply"
								: "object-cover",
						]}
					/>
				) : (
					<div class="flex h-full items-center justify-center">
						<Icon
							name={vehicle.bodyStyle ? getVehicleCategoryIcon(vehicle.bodyStyle) : "car-front"}
							class="h-16 w-16 text-[#9a6b35]/42"
						/>
					</div>
				)
			}
		</div>
		<div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-slate-950/48 to-transparent" aria-hidden="true"></div>
	</div>

	{summary && <p class="mt-5 text-sm leading-7 text-slate-600">{summary}</p>}

	{
		metadataEntries.length > 0 && (
			<div class="mt-6 overflow-hidden rounded-[10px] border border-[#e2d4c3] bg-white/58">
				<dl class="grid md:grid-cols-2">
					{metadataEntries.map((entry) => (
						<div class="border-b border-[#eadfd2] px-4 last:border-b-0 md:odd:border-r">
							<MetadataRow metadataKey={entry.key} icon={entry.icon} label={entry.label} value={entry.value} />
						</div>
					))}
				</dl>
			</div>
		)
	}

	{
		previewSections.map(({ section, icon }) => {
			const preview = getInspectorFirstParagraph(section.content);
			return preview ? (
				<InspectorSection title={section.title} highlightKey="notes" iconColor="#a36d2c" surface="panel" className="mt-7">
					<div class="mb-2 flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-amber-700">
						<Icon name={icon} class="h-4 w-4" />
						<span>Documented</span>
					</div>
					<NoteContent note={note} content={preview} />
				</InspectorSection>
			) : null;
		})
	}

	<a
		href={noteHref}
		data-experience-open-note
		data-note-href={noteHref}
		class="mt-8 flex items-center justify-center gap-2 rounded-[8px] border border-[#b68541] px-4 py-3 text-sm font-semibold text-[#8a5d24] transition hover:bg-[#fff4df]"
	>
		<Icon name="square-arrow-up-right" class="h-4 w-4" />
		Open in Note
	</a>
</div>

<style>
	.vehicle-inspector-action {
		display: inline-flex;
		height: 3rem;
		width: 3rem;
		align-items: center;
		justify-content: center;
		color: rgb(71 85 105);
		transition: color 180ms ease;
	}

	.vehicle-inspector-action:hover {
		color: rgb(163 109 44);
	}
</style>
