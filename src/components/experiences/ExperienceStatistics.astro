---
import type { ExperienceStatistic } from "src/lib/experiences/statistics";

interface Props {
	items: ExperienceStatistic[];
	tone?: "light" | "dark";
}

const { items, tone = "light" } = Astro.props;
---

<div
	class:list={[
		"flex min-w-0 flex-nowrap items-center gap-x-3 overflow-hidden text-sm md:gap-x-4",
		tone === "dark" ? "text-white/70" : "text-slate-500",
	]}
>
	{
		items.map((item) => (
			<div
				class:list={[
					"flex min-w-0 shrink items-baseline gap-1.5 whitespace-nowrap border-l pl-3 first:border-l-0 first:pl-0 md:gap-2 md:pl-4",
					tone === "dark" ? "border-white/20" : "border-[#e9e0d4]",
				]}
			>
				<p
					class:list={[
						"text-[clamp(1.15rem,2vw,1.6rem)] font-semibold tracking-[-0.05em]",
						tone === "dark" ? "text-white" : "text-slate-900",
					]}
				>
					{item.value}
				</p>
				<p
					class:list={[
						"truncate text-[clamp(0.8rem,1.1vw,0.95rem)]",
						tone === "dark" ? "text-white/68" : "text-slate-500",
					]}
				>
					{item.label.toLowerCase()}
				</p>
			</div>
		))
	}
</div>
